<Project>
  <PropertyGroup>
    <FluentShellRoot>$(MSBuildThisFileDirectory)</FluentShellRoot>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v145</PlatformToolset>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <CharacterSet>Unicode</CharacterSet>
    <OutDir>$(FluentShellRoot)build\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(FluentShellRoot)build\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <CppWinRTEnabled>true</CppWinRTEnabled>
    <CppWinRTModernIDL>true</CppWinRTModernIDL>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Source files contain localized diagnostics/comments; keep MSVC's
           source and execution character set deterministic across locales. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
