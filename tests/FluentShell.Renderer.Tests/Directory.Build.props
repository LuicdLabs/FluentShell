<Project>
  <Import Project="..\..\Directory.Build.props" />
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <OutDir>$(FluentShellRoot)build\tests\x64\$(Configuration)\Renderer\</OutDir>
    <BaseIntermediateOutputPath>$(FluentShellRoot)build\obj\Renderer.Tests\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
