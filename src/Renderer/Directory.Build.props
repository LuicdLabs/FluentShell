<Project>
  <Import Project="..\..\Directory.Build.props" />
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputPath Condition="'$(FluentShellTestBuild)' != 'true'">$(FluentShellRoot)build\bin\x64\$(Configuration)\Renderer\</OutputPath>
    <OutDir Condition="'$(FluentShellTestBuild)' != 'true'">$(FluentShellRoot)build\bin\x64\$(Configuration)\Renderer\</OutDir>
    <OutputPath Condition="'$(FluentShellTestBuild)' == 'true'">$(FluentShellRoot)build\tests\x64\$(Configuration)\RendererUnderTest\</OutputPath>
    <OutDir Condition="'$(FluentShellTestBuild)' == 'true'">$(FluentShellRoot)build\tests\x64\$(Configuration)\RendererUnderTest\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <BaseIntermediateOutputPath>$(FluentShellRoot)build\obj\Renderer\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
