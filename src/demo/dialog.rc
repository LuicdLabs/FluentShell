#include <windows.h>
#include "resource.h"

IDD_SYSPROT DIALOGEX 0, 0, 340, 132
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "System Protection"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            "", IDC_WARNICON, 14, 16, 21, 20, SS_ICON
    LTEXT           "You will not be able to undo unwanted system changes on this drive. Are you sure you want to continue?", IDC_MAINTEXT, 46, 14, 282, 30
    LTEXT           "This will delete all restore points on this drive. This might include older system image backups.", IDC_BODYTEXT, 46, 50, 282, 26
    DEFPUSHBUTTON   "Continue", IDC_CONTINUE, 180, 104, 72, 22
    PUSHBUTTON      "Cancel", IDCANCEL, 258, 104, 72, 22
END
