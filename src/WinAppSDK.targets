<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <FluentPackagesDir Condition="'$(FluentPackagesDir)'==''">$(MSBuildThisFileDirectory)..\packages\</FluentPackagesDir>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <Import Project="$(FluentPackagesDir)Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.targets" Condition="Exists('$(FluentPackagesDir)Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.targets')" />
  <Import Project="$(FluentPackagesDir)Microsoft.Web.WebView2.1.0.4078.44\build\native\Microsoft.Web.WebView2.targets" Condition="Exists('$(FluentPackagesDir)Microsoft.Web.WebView2.1.0.4078.44\build\native\Microsoft.Web.WebView2.targets')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.Base.2.0.4\build\native\Microsoft.WindowsAppSDK.Base.targets" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.Base.2.0.4\build\native\Microsoft.WindowsAppSDK.Base.targets')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.Foundation.2.3.5\build\native\Microsoft.WindowsAppSDK.Foundation.targets" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.Foundation.2.3.5\build\native\Microsoft.WindowsAppSDK.Foundation.targets')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.InteractiveExperiences.2.1.3\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences.targets" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.InteractiveExperiences.2.1.3\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences.targets')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.WinUI.2.3.0\build\native\Microsoft.WindowsAppSDK.WinUI.targets" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.WinUI.2.3.0\build\native\Microsoft.WindowsAppSDK.WinUI.targets')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.DWrite.2.1.0\build\native\Microsoft.WindowsAppSDK.DWrite.targets" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.DWrite.2.1.0\build\native\Microsoft.WindowsAppSDK.DWrite.targets')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.2.3.1\build\native\Microsoft.WindowsAppSDK.targets" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.2.3.1\build\native\Microsoft.WindowsAppSDK.targets')" />

  <ItemGroup>
    <ClCompile Remove="$(FluentPackagesDir)Microsoft.WindowsAppSDK.Foundation.2.3.5\include\MddBootstrapAutoInitializer.cpp" />
  </ItemGroup>
</Project>
