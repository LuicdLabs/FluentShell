<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Self-contained deployment (required for injection payload).

    Rules learned from crash analysis:
    1) NEVER call MddBootstrapInitialize while shipping local CoreMessagingXP /
       Microsoft.UI.Xaml next to the EXE — dual-init → CoreMessagingXP 0xC0000602.
    2) XamlControlsResources may fail to resolve ms-appx theme PRI in unpackaged
       self-contained hosts. UI must paint with explicit brushes (no theme dependency).
    3) UndockedRegFree WinRT auto-init is required so Microsoft.UI.* activates from
       local DLLs without package identity.
  -->
  <PropertyGroup>
    <FluentPackagesDir>$(MSBuildThisFileDirectory)..\packages\</FluentPackagesDir>
    <WindowsAppSDKVerifyTransitiveDependencies>false</WindowsAppSDKVerifyTransitiveDependencies>
    <WindowsPackageType>None</WindowsPackageType>

    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKSelfContainedAudit>false</WindowsAppSDKSelfContainedAudit>

    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>

  <Import Project="$(FluentPackagesDir)Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.props" Condition="Exists('$(FluentPackagesDir)Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.props')" />
  <Import Project="$(FluentPackagesDir)Microsoft.Web.WebView2.1.0.4078.44\build\native\Microsoft.Web.WebView2.props" Condition="Exists('$(FluentPackagesDir)Microsoft.Web.WebView2.1.0.4078.44\build\native\Microsoft.Web.WebView2.props')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.Base.2.0.4\build\native\Microsoft.WindowsAppSDK.Base.props" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.Base.2.0.4\build\native\Microsoft.WindowsAppSDK.Base.props')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.Foundation.2.3.5\build\native\Microsoft.WindowsAppSDK.Foundation.props" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.Foundation.2.3.5\build\native\Microsoft.WindowsAppSDK.Foundation.props')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.InteractiveExperiences.2.1.3\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences.props" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.InteractiveExperiences.2.1.3\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences.props')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.WinUI.2.3.0\build\native\Microsoft.WindowsAppSDK.WinUI.props" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.WinUI.2.3.0\build\native\Microsoft.WindowsAppSDK.WinUI.props')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.DWrite.2.1.0\build\native\Microsoft.WindowsAppSDK.DWrite.props" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.DWrite.2.1.0\build\native\Microsoft.WindowsAppSDK.DWrite.props')" />
  <Import Project="$(FluentPackagesDir)Microsoft.WindowsAppSDK.2.3.1\build\native\Microsoft.WindowsAppSDK.props" Condition="Exists('$(FluentPackagesDir)Microsoft.WindowsAppSDK.2.3.1\build\native\Microsoft.WindowsAppSDK.props')" />

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(FluentPackagesDir)Microsoft.WindowsAppSDK.Runtime.2.3.1\include;
        $(FluentPackagesDir)Microsoft.WindowsAppSDK.Foundation.2.3.5\include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>FLUENTSHELL_WASDK_SELF_CONTAINED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="$(FluentPackagesDir)Microsoft.Web.WebView2.1.0.4078.44\lib\Microsoft.Web.WebView2.Core.winmd" Condition="Exists('$(FluentPackagesDir)Microsoft.Web.WebView2.1.0.4078.44\lib\Microsoft.Web.WebView2.Core.winmd')">
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
